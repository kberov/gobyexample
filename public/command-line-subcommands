      var codeLines = [];
      codeLines.push('');codeLines.push('package main\u000A');codeLines.push('import (\u000A    \"flag\"\u000A    \"fmt\"\u000A    \"os\"\u000A)\u000A');codeLines.push('func main() {\u000A');codeLines.push('    алаCmd :\u003D flag.NewFlagSet(\"ала\", flag.ExitOnError)\u000A    алаEnable :\u003D алаCmd.Bool(\"включ\", false, \"включ\")\u000A    алаName :\u003D алаCmd.String(\"име\", \"\", \"име\")\u000A');codeLines.push('    barCmd :\u003D flag.NewFlagSet(\"бала\", flag.ExitOnError)\u000A    barLevel :\u003D barCmd.Int(\"равнище\", 0, \"равнище\")\u000A');codeLines.push('    if len(os.Args) \u003C 2 {\u000A        fmt.Println(\"очавани подкоманди: \'ала\' или \'бала\'\")\u000A        os.Exit(1)\u000A    }\u000A');codeLines.push('    switch os.Args[1] {\u000A');codeLines.push('    case \"ала\":\u000A        алаCmd.Parse(os.Args[2:])\u000A        fmt.Println(\"подкоманда \'ала\'\")\u000A        fmt.Println(\"  включ:\", *алаEnable)\u000A        fmt.Println(\"  име:\", *алаName)\u000A        fmt.Println(\"  още податки:\", алаCmd.Args())\u000A    case \"бала\":\u000A        barCmd.Parse(os.Args[2:])\u000A        fmt.Println(\"подкоманда \'бала\'\")\u000A        fmt.Println(\"  равнище:\", *barLevel)\u000A        fmt.Println(\"  още податки:\", barCmd.Args())\u000A    default:\u000A        fmt.Println(\"очавани подкоманди: \'ала\' или \'бала\'\")\u000A        os.Exit(1)\u000A    }\u000A}\u000A');codeLines.push('');codeLines.push('');codeLines.push('');codeLines.push('');codeLines.push('');
    </script>
