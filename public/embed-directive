      codeLines.push('package main\u000A');codeLines.push('import (\u000A    \"embed\"\u000A)\u000A');codeLines.push('//go:embed folder/single.txt\u000Avar fileString string\u000A');codeLines.push('//go:embed folder/single.txt\u000Avar fileByte []byte\u000A');codeLines.push('//go:embed folder/single.txt\u000A//go:embed folder/*.hash\u000Avar folder embed.FS\u000A');codeLines.push('func main() {\u000A');codeLines.push('    print(fileString)\u000A    print(string(fileByte))\u000A');codeLines.push('    content1, _ :\u003D folder.ReadFile(\"folder/file1.hash\")\u000A    print(string(content1))\u000A');codeLines.push('    content2, _ :\u003D folder.ReadFile(\"folder/file2.hash\")\u000A    print(string(content2))\u000A');codeLines.push('    content3, _ :\u003D folder.ReadFile(\"folder/single.txt\")\u000A    print(string(content3))\u000A}\u000A');codeLines.push('');codeLines.push('');
