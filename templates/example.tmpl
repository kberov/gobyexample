<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Go в примери: {{.Name}}</title>
    <link rel=stylesheet href="chota.v0.9.2.min.css">
    <link rel=stylesheet href="site.css">
  </head>
  <script>
      window.onkeydown = (e) => {
          if (e.ctrlKey || e.altKey || e.shiftKey || e.metaKey) {
              return;
          }
          {{if .PrevExample}}
          if (e.key == "ArrowLeft") {
              window.location.href = '{{.PrevExample.ID}}{{.PrevExample.FileNameSufix}}';
          }
          {{end}}
          {{if .NextExample}}
          if (e.key == "ArrowRight") {
              window.location.href = '{{.NextExample.ID}}{{.NextExample.FileNameSufix}}';
          }
          {{end}}
      }
  </script>
  <body>
    <div class="container" id="{{.ID}}">
      <h2><a href="./index.html">Go в примери</a>: {{.Name}}</h2>
      {{range .Segs}}
        <div class="row">
        {{range .}}
            <div class="col-6">
            {{.DocsRendered}}
          </div>
          <div class="col-6 code{{if .CodeEmpty}} empty{{end}}{{if .CodeLeading}} leading{{end}}">
            {{if .CodeRun}}<a href="https://go.dev/play/p/{{$.URLHash}}"><img title="Run code" src="play.png" class="run" /></a><img title="Copy code" src="clipboard.png" class="copy" />{{end}}
          {{.CodeRendered}}
          </div>
        {{end}}
          </div><!-- end class="row" -->
      {{end}}
      {{if .NextExample}}
      <p class="next">
        Следващ пример: <a href="{{.NextExample.ID}}{{.NextExample.FileNameSufix}}" rel="next">{{.NextExample.Name}}</a>.
      </p>
      {{end}}
{{ template "footer" }}
    </div>
    <script>
      var codeLines = [];
      {{range .Segs}}{{range .}}codeLines.push('{{js .CodeForJs}}');{{end}}{{end}}
    </script>
    <script src="site.js" async></script>
  </body>
</html>
