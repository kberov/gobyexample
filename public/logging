    <script>
      var codeLines = [];
      codeLines.push('package main\u000A');codeLines.push('import (\u000A    \"bytes\"\u000A    \"fmt\"\u000A    \"log\"\u000A    \"log/slog\"\u000A    \"os\"\u000A)\u000A');codeLines.push('func main() {\u000A');codeLines.push('    log.Println(\"стандартния отчетник\")\u000A');codeLines.push('    log.SetFlags(log.LstdFlags | log.Lmicroseconds)\u000A    log.Println(\"с микросекунди\")\u000A');codeLines.push('    log.SetFlags(log.LstdFlags | log.Lshortfile)\u000A    log.Println(\"с файл и ред\")\u000A');codeLines.push('    моят :\u003D log.New(os.Stdout, \"мой:\", log.LstdFlags)\u000A    моят.Println(\"от мен\")\u000A');codeLines.push('    моят.SetPrefix(\"моят:\")\u000A    моят.Println(\"от моя\")\u000A');codeLines.push('    var buf bytes.Buffer\u000A    buflog :\u003D log.New(\u0026buf, \"buf:\", log.LstdFlags)\u000A');codeLines.push('    buflog.Println(\"здрасти\")\u000A');codeLines.push('    fmt.Print(\"от \'buflog\':\", buf.String())\u000A');codeLines.push('    jsonHandler :\u003D slog.NewJSONHandler(os.Stderr, nil)\u000A    myslog :\u003D slog.New(jsonHandler)\u000A    myslog.Info(\"хей, здравей\")\u000A');codeLines.push('    myslog.Info(\"здрасти пак\", \"ключ\", \"стойност\",\u000A        \"възраст\", 25)\u000A}\u000A');codeLines.push('');codeLines.push('');
    </script>
